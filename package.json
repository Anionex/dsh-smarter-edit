{
  "name": "@anionex/dsh-smarter-edit",
  "version": "0.1.6",
  "description": "A better approach to editing files in DSH.",
  "homepage": "https://github.com/Anionex/dsh-smarter-edit#readme",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anionex/dsh-smarter-edit.git"
  },
  "bugs": {
    "url": "https://github.com/Anionex/dsh-smarter-edit/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engine": {
      "types": "./lib/types/engine.d.ts",
      "default": "./lib/engine.js"
    },
    "./parser": {
      "types": "./lib/types/parser.d.ts",
      "default": "./lib/parser.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "third_party",
    "assets",
    "docs",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.1 <0.2.0",
      "profiles": [
        "desktop",
        "web",
        "headless"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "check": "tsc -p tsconfig.json && pnpm run build && node --test tests/*.test.mjs && pnpm pack --dry-run",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "apply-patch",
    "freeform-tool",
    "codex"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^8.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-authorization": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "3.18.2",
    "@earendil-works/pi-ai": "0.84.4",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "react": "18.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
